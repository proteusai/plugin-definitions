{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "<TEAMS_APP_ID>",
  "packageName": "com.onbuddy.bot",
  "developer": {
    "name": "OnBuddy",
    "websiteUrl": "https://onbuddy.app",
    "privacyUrl": "https://onbuddy.app/privacy",
    "termsOfUseUrl": "https://onbuddy.app/terms"
  },
  "name": {
    "short": "OnBuddy",
    "full": "OnBuddy AI Assistant"
  },
  "description": {
    "short": "Ask questions and receive task notifications.",
    "full": "OnBuddy connects your team to your AI-powered onboarding assistant. Ask questions, get task reminders, and stay on top of your onboarding — all within Microsoft Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",
  "bots": [
    {
      "botId": "<TEAMS_APP_ID>",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["<your-domain-without-https>"]
}